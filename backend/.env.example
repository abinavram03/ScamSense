# ── ScamSense backend configuration ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.

# MongoDB connection string. Leave as-is to use the in-memory mock.
MONGO_URL="mongodb://localhost:27017"

# Database name
DB_NAME="test_database"

# Comma-separated list of allowed origins for CORS.
# Use an explicit list in production (e.g. http://localhost:3000).
CORS_ORIGINS="*"

# Signing key for JWT access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="replace-me-with-a-long-random-secret"

# Admin account seeded on startup
ADMIN_EMAIL="ScamSense@admin.com"
ADMIN_PASSWORD="SS012"

# Set to "production" to enable secure / SameSite=None cookies
# ENV="production"
