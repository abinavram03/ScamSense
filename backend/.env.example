# ── ScamSense backend configuration ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.

# MongoDB connection string. Leave as-is to use the in-memory mock.
MONGO_URL="mongodb://localhost:27017"

# Database name
DB_NAME="test_database"

# Comma-separated list of allowed origins for CORS.
#
# Do NOT use "*" here. The frontend sends withCredentials: true, and browsers
# reject a credentialed response whose Access-Control-Allow-Origin is the
# wildcard "*". That surfaces in the UI as a generic "Network Error" even
# though the endpoint works from curl or Postman.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Signing key for JWT access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="replace-me-with-a-long-random-secret"

# Admin account seeded on startup
ADMIN_EMAIL="ScamSense@admin.com"
ADMIN_PASSWORD="SS012"

# Set to "production" to enable secure / SameSite=None cookies
# ENV="production"

# Optional: lifts the translation quota.
#
# The translator uses MyMemory's public endpoint, which needs no key but allows
# only a few thousand words per day per IP address. Once that runs out,
# /api/translate returns a clear "quota used up" message and the scan itself is
# unaffected. Set either of these to remove the limit:
#
#   MYMEMORY_EMAIL="you@example.com"   -> 50,000 words/day, no signup
#   MYMEMORY_API_KEY="..."             -> higher limits, from mymemory.com
#
# Leave both unset to run keyless.
# MYMEMORY_EMAIL=""
# MYMEMORY_API_KEY=""

# ── Domain reputation (optional) ──────────────────────────────────
#
# Reputation is layered on top of the ML score. Every source below is
# optional and fails soft: with no keys at all the app still runs, and RDAP,
# DNS, the OpenPhish feed and the redirect trace still contribute evidence.
#
# How the adjustment works
#   final = min(1.0, ML score + reputation points)
#
#   known malicious (Safe Browsing / OpenPhish)  +20
#   3+ VirusTotal engines agree                   +10
#   registered under 30 days ago                  + 5
#   suspicious redirect chain                     + 5
#   domain does not resolve in DNS                +10
#   ---------------------------------------------------
#   capped at +40, so reputation can never push a safe domain into the
#   high-risk band on its own, and it can never lower a score.
#
# Google Safe Browsing
#   Free key: https://developers.google.com/safe-browsing/v4/get-started
#   Without it, /predict reports "not configured" for this source and moves on.
# GOOGLE_SAFE_BROWSING_API_KEY=""

# VirusTotal
#   Free key: https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=""
